# Copy this file to ".env" and fill in your MongoDB Atlas connection string.
#
#   cp .env.example .env
#
# 1. Create a free cluster at https://www.mongodb.com/atlas
# 2. Add a database user (Database Access) and allow your IP (Network Access)
# 3. Connect > Drivers > Node.js, then copy the connection string
#
# Replace <password> with your database user's password:
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Optional: override the database name (defaults to "life_management").
MONGODB_DB=life_management
